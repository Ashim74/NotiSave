<?xml version="1.0" encoding="utf-8"?><!--
   Auto Backup rules for API 23–30 (API 31+ uses data_extraction_rules.xml).
   allowBackup is false today, but the app-lock file is excluded explicitly so a future
   backup feature can never restore a lock (or its recovery hash) onto another device.
-->
<full-backup-content>
    <exclude domain="file" path="datastore/app_lock.preferences_pb" />
</full-backup-content>
