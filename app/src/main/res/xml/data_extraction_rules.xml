<?xml version="1.0" encoding="utf-8"?><!--
   API 31+ backup and device-to-device transfer rules. Device transfer still runs when
   allowBackup is false, so the app-lock file must be excluded here explicitly: a lock should
   never follow history to a new phone, where the "phone screen lock" recovery would differ.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/app_lock.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/app_lock.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
